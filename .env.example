# Copy to .env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000

# Must be a replica set (transactions). An Atlas URI works as-is; a local mongod must be
# started with --replSet rs0 and initiated once (see README).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/events?retryWrites=true&w=majority
# If startup fails with "querySrv ETIMEOUT", your network's DNS is blocking the SRV lookup
# that mongodb+srv needs. Point Node at public DNS instead:
DNS_SERVERS=8.8.8.8,1.1.1.1

# At least 16 characters each. Access tokens last 15 min, refresh tokens 7 days.
JWT_ACCESS_SECRET=change-me-access-secret-please
JWT_REFRESH_SECRET=change-me-refresh-secret-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# Comma-separated CORS allowlist. The first origin is used for links in emails.
CLIENT_URL=http://localhost:5173

# Paystack. "demo" (default) simulates payments: checkout links open a demo page on this
# API with Pay/Decline buttons, so no Paystack account is needed. Use "live" with a real key
# (test keys start with sk_test_); the same key verifies webhook signatures.
PAYSTACK_MODE=demo
PAYSTACK_SECRET_KEY=
# Public URL of this API, used for demo checkout links (defaults to http://localhost:$PORT).
APP_URL=http://localhost:4000
HOLD_MINUTES=15

# Platform commission per paid ticket, deducted from the organizer's share.
# 5 = 5%. PLATFORM_FEE_FLAT is added on top in kobo (10000 = ₦100).
PLATFORM_FEE_PERCENT=5
PLATFORM_FEE_FLAT=0
# Organizer earnings are held until this many days after the event ends, then paid out.
PAYOUT_HOLD_DAYS=3

# Email via Brevo transactional API (Brevo dashboard -> SMTP & API -> API keys).
# The sender address must be a verified sender in Brevo.
BREVO_API_KEY=
MAIL_FROM=Events <no-reply@yourdomain.com>
# Alternative: any SMTP server, e.g. Brevo's relay smtp-relay.brevo.com:587 with your SMTP login/key.
# Used only when BREVO_API_KEY is empty. With neither set, emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Banner uploads (Cloudinary dashboard -> API Keys). Leave empty to disable uploads (503).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=event-banners
# Alternative to the three above: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

LOG_LEVEL=info
